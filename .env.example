# --- Core ---
ENV=local
HOST=0.0.0.0
PORT=4226
LOG_LEVEL=INFO

# --- Database ---
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=clinic_platform

# --- Clinic behaviour ---
CLINIC_TIMEZONE=Asia/Kolkata
CLINIC_CURRENCY=INR
MIN_BOOKING_NOTICE_MINUTES=30
SESSION_RESUME_WINDOW_MINUTES=30
CALLBACK_WINDOW_HOURS=48

# --- LiveKit (web calls + agent dispatch) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
WORKER_AGENT_NAME=clinic-voice-agent

# --- Auth (empty = open, local dev only) ---
INTERNAL_SERVICE_KEY=

# --- PMS write-back: "mock" (built-in, zero setup) or "cliniko" (real account) ---
PMS_PROVIDER=mock

# --- Real Cliniko (when PMS_PROVIDER=cliniko) ---
# Key from Cliniko -> My info -> Manage API keys; shard is inferred from the
# key suffix (e.g. ...-au5). Then run: python scripts/cliniko_link.py
CLINIKO_API_KEY=
CLINIKO_USER_AGENT=Apollo Clinic Voice Agent (you@example.com)

# --- Mock PMS ---
PMS_BASE_URL=http://localhost:4226/pms/api/v1
PMS_API_KEY=pms_test_key
PMS_CHAOS_FAILURE_RATE=0.0
PMS_RETRY_INTERVAL_SECONDS=20
PMS_MAX_RETRY_ATTEMPTS=10

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
